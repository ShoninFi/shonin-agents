# Per-developer settings only. Copy to .env (gitignored) and fill it in.

# Where the platform you are publishing to is running. These are its defaults.
# SHONIN_API_URL=http://localhost:19081
# SHONIN_RPC_URL=http://localhost:19083

# The account that owns what you publish. On a development chain this is one
# of the accounts it hands out, named by index; leave it unset to use the
# author account the platform's own .env.example describes.
# SHONIN_AUTHOR_KEY=

# A checkout of the platform, so the SDK can be patched to it while the two
# move together. Without it, cargo resolves the SDK from the registry.
# SHONIN_PLATFORM_DIR=
